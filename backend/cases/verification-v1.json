{
  "version": "verification/1.0.0",
  "scope": "Known abstract-model verification cases; no held-out comparison or mission frequencies",
  "tau_s": 2,
  "energy_threshold": 0.05,
  "cases": [
    {"id":"nominal", "purpose":"No-fault remove and return control", "initial":{},
     "steps":[{"action":"isolate"},{"action":"wait","dt":10},{"action":"secure"},{"action":"unlock"},{"action":"separate"},{"action":"mate"},{"action":"lock"},{"action":"release_support"},{"action":"energize"}],
     "expect":{"accepted":[true,true,true,true,true,true,true,true,true],"task_completed":true,"acceptable_completion":true}},
    {"id":"impossible-separation", "purpose":"Bypass policy to test structural rejection without mutation", "initial":{},
     "steps":[{"action":"separate","guarded":false}],
     "expect":{"accepted":[false]}},
    {"id":"residual-energy", "purpose":"Negative control: isolation alone does not permit demating", "initial":{"host":"open","support":"secured","source":"isolated","energy_fraction":1},
     "steps":[{"action":"separate","guarded":false}],
     "expect":{"accepted":[true],"unsafe_connector_transition":true}},
    {"id":"unsafe-energization", "purpose":"Negative control: physically possible unsafe command", "initial":{"host":"partial","support":"secured","source":"isolated","energy_fraction":0},
     "steps":[{"action":"energize","guarded":false}],
     "expect":{"accepted":[true],"unsafe_energization":true}},
    {"id":"retention-loss", "purpose":"Negative control: release the only load path", "initial":{"host":"open","support":"secured","connector":"separated","source":"isolated","energy_fraction":0},
     "steps":[{"action":"release_support","guarded":false}],
     "expect":{"accepted":[true],"retention_loss":true}},
    {"id":"false-report", "purpose":"Single false-negative host report changes belief, never truth", "initial":{"support":"secured","source":"isolated","energy_fraction":0},
     "steps":[{"action":"release_support","false_host":"partial"}],
     "expect":{"accepted":[false],"safe_abort":true}},
    {"id":"stale-ack", "purpose":"Stale reports and command-receipt ACK establish no current lock", "initial":{"support":"secured","source":"isolated","energy_fraction":0},
     "steps":[{"action":"release_support","stale":true,"ack":true}],
     "expect":{"accepted":[false],"safe_abort":true}},
    {"id":"communication-loss", "purpose":"Missing telemetry does not imply physical failure or permit progress", "initial":{"host":"open","support":"secured","connector":"separated","source":"isolated","energy_fraction":0},
     "steps":[{"action":"mate","missing":true}],
     "expect":{"accepted":[false],"safe_abort":true}},
    {"id":"restart", "purpose":"Prior-epoch evidence rejected; support and plant state persist by assumption", "initial":{"support":"secured","source":"isolated","energy_fraction":0},
     "steps":[{"action":"hold"},{"action":"release_support","restart":true,"old_epoch":true}],
     "expect":{"accepted":[true,false],"safe_abort":true}},
    {"id":"partial-latch", "purpose":"Single partial actuation is visible to ideal sensors; support retained", "initial":{"host":"open","support":"secured","source":"isolated","energy_fraction":0},
     "steps":[{"action":"lock","partial":true},{"action":"release_support"}],
     "expect":{"accepted":[true,false],"safe_abort":true}},
    {"id":"unexpected-contact", "purpose":"Contact flag prevents motion; no load magnitude inferred", "initial":{"support":"secured","source":"isolated","energy_fraction":0,"contact":"unexpected"},
     "steps":[{"action":"unlock"}],
     "expect":{"accepted":[false]}},
    {"id":"adversarial-false-positive", "purpose":"Combined partial actuation and false-positive report: guard can be unsafe when its assumed belief excludes truth; not a mission-rate sample", "initial":{"host":"open","support":"secured","source":"isolated","energy_fraction":0},
     "steps":[{"action":"lock","partial":true},{"action":"release_support","false_host":"locked"}],
     "expect":{"accepted":[true,true],"retention_loss":true}},
    {"id":"completion-after-hazard", "purpose":"Eventual completion cannot erase energized demating", "initial":{"host":"open","support":"secured","source":"isolated","energy_fraction":1},
     "steps":[{"action":"separate","guarded":false},{"action":"wait","dt":10},{"action":"mate"},{"action":"lock"},{"action":"release_support"},{"action":"energize"}],
     "expect":{"accepted":[true,true,true,true,true,true],"unsafe_connector_transition":true,"task_completed":true}},
    {"id":"inconsistent-evidence", "purpose":"Contradictory current reports create an empty belief, never vacuous permission", "initial":{"support":"secured","source":"isolated","energy_fraction":0},
     "steps":[{"action":"release_support","contradictory_host":true}],
     "expect":{"accepted":[false],"safe_abort":true}},
    {"id":"null-control", "purpose":"A hold command need not achieve service completion", "initial":{},
     "steps":[{"action":"hold"}],
     "expect":{"accepted":[true]}}
  ]
}
