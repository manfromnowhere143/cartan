+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {readFileSync} from 'node:fs';
+import {workspaceFromURL,workspaceURL,parentState,inspectionFacts,PARTS,RECORDS} from '../workspace-state.mjs';
+import {projectV1} from '../contract-adapter.mjs';
+const parse=s=>workspaceFromURL(new URL(s,'https://cartan.danielwahnich.dev'));
+test('every selection round-trips without hidden state, including evidence context',()=>{
+  for(const part of PARTS)for(const record of RECORDS) {
+    for(const path of ['/laboratory/?detail=interface','/interruption/','/evidence/?from=interruption','/comparison/?from=interruption','/sources/']) {
+      const u=new URL(path,'https://cartan.danielwahnich.dev');u.searchParams.set('part',part);u.searchParams.set('record',record);
+      const state=parse(u.href),canonical=parse(workspaceURL(state));
+      assert.equal(canonical.view,state.view);assert.equal(canonical.part,state.part);
+      assert.equal(canonical.detail,state.detail);assert.equal(canonical.from,state.from);
+      if(state.view==='evidence')assert.equal(canonical.record,record);
+    }
+  }
+});
+test('unknown query states cannot become a selected part or evidence category',()=>{
+  assert.deepEqual(parse('/laboratory/?part=thruster&detail=release&record=success&from=control'),{view:'laboratory',part:'module',detail:null,record:'planned',from:null});
+  assert.equal(parse('/#interruption').part,'retention');
+});
+test('Escape follows interface, part and containing view while preserving the object',()=>{
+  let s=parse('/evidence/?part=support&from=interruption');
+  for(const expected of ['interruption','laboratory','laboratory','laboratory','home']){s=parentState(s);assert.equal(s.view,expected);}
+  assert.equal(s.part,'module');
+});
+test('comparison is exactly the pinned candidates, without derived geometry or probability',()=>{
+  const projection=projectV1(JSON.parse(readFileSync(new URL('../vendor/cartan/v1/fixture.json',import.meta.url))));
+  const facts=inspectionFacts(projection);
+  assert.equal(facts.value,'received');assert.equal(facts.validity,'stale');assert.equal(facts.source,'src-model-proposal');
+  assert.deepEqual(facts.candidates.map(c=>c.host),['partial','locked']);assert.equal(facts.assignedHost,'partial');
+  assert.deepEqual(Object.keys(facts.candidates[0]),['host','support','connector','source']);
+  projection.run.mode='physical_test';assert.throws(()=>inspectionFacts(projection));
+});
diff --git a/frontend/workspace-state.mjs b/frontend/workspace-state.mjs
new file mode 100644
index 0000000..92b15ec
--- /dev/null
+++ b/frontend/workspace-state.mjs
@@ -0,0 +1,39 @@
+import {pathFor,viewFromURL} from './routes.mjs';
+
+export const PARTS=['module','retention','isolation','support'];
+export const RECORDS=['planned','simulation','physical_test','inconclusive'];
+const member=(value,values,fallback)=>values.includes(value)?value:fallback;
+
+// The URL is the only persistent selection state. Unknown values are never data.
+export function workspaceFromURL(url) {
+  const view=viewFromURL(url),p=new URLSearchParams(url.search);
+  return {view,part:member(p.get('part'),PARTS,view==='interruption'?'retention':'module'),
+    detail:view==='laboratory'&&p.get('detail')==='interface'?'interface':null,
+    record:member(p.get('record'),RECORDS,'planned'),
+    from:p.get('from')==='interruption'&&['evidence','comparison','sources'].includes(view)?'interruption':null};
+}
+export function workspaceURL(state) {
+  const p=new URLSearchParams();
+  if(state.view!=='home'&&PARTS.includes(state.part)&&(state.part!=='module'||state.view==='interruption'))p.set('part',state.part);
+  if(state.view==='laboratory'&&state.detail==='interface')p.set('detail','interface');
+  if(state.view==='evidence'&&RECORDS.includes(state.record)&&state.record!=='planned')p.set('record',state.record);
+  if(['evidence','comparison','sources'].includes(state.view)&&state.from==='interruption')p.set('from','interruption');
+  return pathFor(state.view)+(p.size?'?'+p:'');
+}
+export function parentState(state) {
+  if(state.view==='laboratory'&&state.detail)return {...state,detail:null};
+  if(state.view==='laboratory'&&state.part!=='module')return {...state,part:'module'};
+  const parent={home:'home',question:'home',laboratory:'home',interruption:'laboratory',
+    evidence:state.from==='interruption'?'interruption':'home',comparison:'evidence',sources:'question',vision:'home'};
+  return {...state,view:parent[state.view]??'home',detail:state.view==='interruption'?'interface':null};
+}
+
+/** A text-only projection. It does not derive physical geometry or probabilities. */
+export function inspectionFacts({run,observation,belief,truth}) {
+  if(run.mode!=='synthetic_fixture'||run.evidence_scope!=='none')throw new Error('Unsupported inspection mode');
+  return {notice:run.display_notice,variable:observation.variable,value:String(observation.reading.value),
+    validity:observation.validity,source:observation.source_id,sampled:observation.sampled_at_s,
+    received:observation.received_at_s,epoch:observation.epoch,
+    candidates:belief.candidates.map(c=>({host:c.host,support:c.support,connector:c.connector,source:c.source})),
+    assignedHost:truth.state.host};
+}
